# ==========================================
# HaoHanWeb Rust Backend Environment Config
# ==========================================

# Application Runtime
APP_ENV=development
PORT=3001
BIND_ADDR=0.0.0.0:3001
RUST_LOG=info,sqlx=warn
FRONTEND_URL=http://localhost:3000
PUBLIC_API_URL=http://localhost:3001
STATUS_POLL_INTERVAL_SECONDS=10
RATE_LIMIT_ENABLED=true

# Embedded SQLite Database (WAL mode)
# Local dev default: sqlite://data/haohan.db
# Production Docker/Render volume: sqlite:///data/haohan.db
DATABASE_URL=sqlite://data/haohan.db

# Security Secrets (REQUIRED when APP_ENV=production)
JWT_SECRET=super_secret_jwt_key_987
GAME_SERVER_TOKEN=super_secure_server_token_123

# Discord OAuth2, Bot & Webhook
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://localhost:3000/vi/discord/callback
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
DISCORD_WEBHOOK_URL=
DISCORD_DONATION_CHANNEL_ID=
DISCORD_DONATION_AUTO_REFRESH=false
DISCORD_DONATION_REFRESH_INTERVAL_SECONDS=86400

# PayOS Payment Gateway
PAYOS_CLIENT_ID=
PAYOS_API_KEY=
PAYOS_CHECKSUM_KEY=

# Minecraft Server (SLP Ping & RCON)
MINECRAFT_HOST=127.0.0.1
MINECRAFT_PORT=25565
RCON_HOST=127.0.0.1
RCON_PORT=25575
RCON_PASSWORD=

# Cloudinary Avatar Storage (optional; falls back to Discord CDN URL)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Litestream Replication (optional backup to S3/R2)
LITESTREAM_REPLICA_URL=
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
